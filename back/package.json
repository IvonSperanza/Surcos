{
    "name": "surco-back",
    "version": "0.1.0",
    "type": "commonjs",
    "main": "src/index.ts",
    "license": "ISC",
    "scripts": {
        "dev": "nodemon src/index.ts",
        "build": "rm -rf ./dist/ && tsc && tsc-alias",
        "start:prod": "node dist/src/index.js",
        "lint": "eslint src/",
        "lint:cycles": "madge --circular --extensions ts src",
        "test": "NODE_ENV=dev npx vitest run",
        "seed": "ts-node seeders/index.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:migrate:run": "ts-node src/db/migrate.ts",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "bradb": "^3.1.6",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "drizzle-orm": "^0.44.7",
        "express": "^5.1.0",
        "pg": "^8.23.0",
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.9.0",
        "@types/cors": "^2.8.13",
        "@types/express": "^5.0.3",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^6.0.2",
        "drizzle-kit": "^0.31.11",
        "drizzle-zod": "^0.8.3",
        "eslint": "^9.9.0",
        "eslint-plugin-complexity": "^1.0.2",
        "eslint-plugin-sonarjs": "^4.2.1",
        "globals": "^15.9.0",
        "madge": "^8.0.0",
        "nodemon": "^3.0.3",
        "supertest": "^6.3.4",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.5",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.0.1",
        "vitest": "^5.0.1"
    }
}
